COMPANION_ENV=development
COMPANION_APP_NAME=AI Learning Companion Core
COMPANION_HOST=127.0.0.1
COMPANION_PORT=8000
# Optional absolute override:
# COMPANION_DATABASE_URL=sqlite:////Users/you/data/companion.sqlite3
COMPANION_TIMEZONE=Asia/Taipei
COMPANION_USER_ID=default
COMPANION_BUSY_MAX_DURATION_HOURS=24
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1
LLM_TIMEOUT_SECONDS=30
CONVERSATION_CONTEXT_LIMIT=20
MEMORY_CONTEXT_LIMIT=5
EMBEDDINGS_ENABLED=true
EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768
EMBEDDING_TIMEOUT_SECONDS=10
LEARNING_CONTEXT_LIMIT=3
COMPANION_PROACTIVE_POLL_INTERVAL_SECONDS=30
COMPANION_PROACTIVE_REVIEW_IDLE_SECONDS=600
COMPANION_PROACTIVE_CONVERSATION_IDLE_SECONDS=1800
COMPANION_PROACTIVE_SNOOZE_MINUTES=30
COMPANION_PROACTIVE_ACCEPT_COOLDOWN_MINUTES=60
COMPANION_PROACTIVE_DAILY_LIMIT=3
# COMPANION_POSE_MODEL=/Users/you/models/pose_landmarker.task
# COMPANION_GESTURE_MODEL=/Users/you/models/gesture_recognizer.task
# Explicit AVFoundation index; the target UAT Mac uses 1 for its built-in camera.
# No indices are automatically probed, which avoids waking Continuity Camera.
COMPANION_GESTURE_CAMERA_INDEX=0
# COMPANION_CORE_LOG_PATH=/Users/you/Library/Logs/ai-learning-companion/core.log
# COMPANION_GESTURE_LOG_PATH=/Users/you/Library/Logs/ai-learning-companion/gestures.log
